{
  "name": "@circle/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/",
    "test:integration": "node --test test/queues.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "bullmq": "6.5.4",
    "dotenv": "18.0.9",
    "ioredis": "6.0.0",
    "@circle/config": "workspace:*",
    "@circle/constants": "workspace:*"
  }
}
