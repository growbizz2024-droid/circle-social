{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "node scripts/prepare-test-db.mjs && node --test --test-concurrency=1 test/integration.mjs test/identity.mjs test/onboarding.mjs test/registration.mjs test/location.mjs test/feed.mjs test/avatars.mjs test/themes.mjs test/https-passkeys.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "node scripts/prepare-test-db.mjs && node --test --test-concurrency=1 test/integration.mjs test/identity.mjs test/onboarding.mjs test/registration.mjs test/location.mjs test/feed.mjs test/avatars.mjs test/themes.mjs test/https-passkeys.mjs",
    "generate": "prisma generate",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "docs:api": "node scripts/export-openapi.mjs",
    "db:avatars:backfill": "node scripts/backfill-avatars.mjs"
  },
  "dependencies": {
    "@circle/config": "workspace:*",
    "@circle/constants": "workspace:*",
    "@circle/shared-types": "workspace:*",
    "@circle/validation": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.11.0",
    "@simplewebauthn/server": "14.0.3",
    "bullmq": "6.5.4",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "maxmind": "5.0.8",
    "music-metadata": "12.3.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "@circle/avatar-engine": "workspace:*",
    "@circle/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
