    "/v1/posts": {
      "post": {
        "operationId": "SocialFeedController_publish",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "communityId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "attachmentIds": {
                    "default": [],
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "mediaUrls": {
                    "default": [],
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "/onboarding/ember.jpg",
                        "/onboarding/clouds.jpg",
                        "/onboarding/botanical.jpg",
                        "/onboarding/alpine.jpg",
                        "/onboarding/city.jpg",
                        "/onboarding/midnight.jpg"
                      ]
                    }
                  },
                  "interests": {
                    "default": [],
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "technology",
                        "relationships",
                        "lifestyle",
                        "business",
                        "education",
                        "entertainment",
                        "food",
                        "travel",
                        "fitness",
                        "fashion",
                        "mental-health",
                        "gaming",
                        "books",
                        "politics",
                        "local-issues"
                      ]
                    }
                  }
                },
                "required": [
                  "communityId",
                  "text",
                  "attachmentIds",
                  "mediaUrls",
                  "interests"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "Social feed"
        ]
