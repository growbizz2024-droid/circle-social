      "post": {
        "operationId": "AuthController_registrationOptions",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "handle": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 40,
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "avatar": {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "number",
                        "enum": [
                          1
                        ]
                      },
                      "seed": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "config": {
                        "type": "object",
                        "properties": {
                          "head": {
                            "type": "string",
                            "enum": [
                              "oval",
                              "round",
                              "angular",
                              "pill"
                            ]
                          },
                          "body": {
                            "type": "string",
                            "enum": [
                              "relaxed",
                              "broad",
                              "tapered"
                            ]
                          },
                          "skinTone": {
                            "type": "string",
                            "enum": [
                              "porcelain",
                              "sand",
                              "warm-beige",
                              "olive",
                              "golden",
                              "caramel",
                              "umber",
                              "cocoa",
                              "espresso",
                              "deep"
                            ]
                          },
                          "hair": {
                            "type": "string",
                            "enum": [
                              "crop",
                              "swept",
                              "waves",
                              "curls",
                              "locs",
                              "bob",
                              "long",
                              "bun",
                              "shaved"
                            ]
                          },
                          "hairColor": {
                            "type": "string",
                            "enum": [
                              "ink",
                              "espresso",
                              "chestnut",
                              "copper",
                              "honey",
                              "silver",
                              "plum",
                              "teal"
                            ]
                          },
                          "outfit": {
                            "type": "string",
                            "enum": [
                              "hoodie",
                              "bomber",
                              "knit",
                              "tee",
                              "blazer",
                              "jersey",
                              "techwear",
                              "future"
                            ]
                          },
                          "accessory": {
                            "type": "string",
                            "enum": [
                              "none",
                              "round-glasses",
                              "shades",
                              "headphones",
                              "cap",
                              "beanie",
                              "visor"
                            ]
                          },
                          "background": {
                            "type": "string",
                            "enum": [
                              "ember-gradient",
                              "night-solid",
                              "cream-solid",
                              "orange-solid",
                              "plum-gradient",
                              "teal-gradient",
                              "orbital-abstract",
                              "contour-abstract"
                            ]
                          },
                          "style": {
                            "type": "string",
                            "enum": [
                              "faceless",
                              "abstract",
                              "expressive"
                            ]
                          }
                        },
                        "required": [
                          "head",
                          "body",
                          "skinTone",
                          "hair",
                          "hairColor",
                          "outfit",
                          "accessory",
                          "background",
                          "style"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "version",
                      "seed",
                      "config"
                    ],
                    "additionalProperties": false
                  },
                  "intent": {
                    "type": "string",
                    "enum": [
                      "create",
                      "add"
                    ]
